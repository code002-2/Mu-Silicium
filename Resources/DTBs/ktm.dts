					interrupt-controller = [];
					#interrupt-cells = <0x2>;
					phandle = <0x68B>;
					key_vol_down {
						key_vol_down_default {
							pins = [gpio6];
							function = [normal];
							input-enable = [];
							bias-pull-up = [];
